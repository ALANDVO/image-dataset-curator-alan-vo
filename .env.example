# Application environment — copy to .env and fill in secrets before starting
# Never commit .env with real credentials.

# ─── Backend ────────────────────────────────────────────────────────────────

# Database (SQLite file path; default is ./data/curator.db)
DATABASE_URL=sqlite:///./data/curator.db

# Session signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# OIDC / Keycloak (leave blank to use DEMO_MODE locally)
OIDC_DISCOVERY_URL=http://localhost:8080/realms/curator/.well-known/openid-configuration
OIDC_CLIENT_ID=curator-app
OIDC_CLIENT_SECRET=

# Frontend origin (used for CORS and redirect URIs)
FRONTEND_URL=http://localhost:5173

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# Demo mode — local-only; startup refuses this when PRODUCTION=true
DEMO_MODE=false

# Set to true in production to block demo mode and enforce HTTPS cookies
# PRODUCTION=true

# ─── LLM (optional) ─────────────────────────────────────────────────────────
# LLM_API_KEY=           # Provider API key — NEVER commit a real key
# LLM_PROVIDER=openai-compatible   # openai-compatible | anthropic | gemini
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ─── Keycloak (Docker Compose) ───────────────────────────────────────────────
KC_ADMIN_PASSWORD=
KC_DB=dev-file
